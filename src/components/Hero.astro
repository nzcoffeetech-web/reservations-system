<main class="min-h-screen grid grid-cols-1 md:grid-cols-2">
      
  <div class="relative h-[50vh] md:h-screen order-2 md:order-1">
    <div class="absolute inset-0 bg-black/40 z-10"></div>
    <img 
      src="/nz-og.jpg" 
      alt="NZ Coffee Ambiance" 
      fetchpriority="high"
      loading="eager"
      class="w-full h-full object-cover grayscale-[30%] contrast-125"
    />
  </div>

  <div class="flex flex-col justify-center px-8 md:px-20 py-20 order-1 md:order-2 bg-premium-black relative">
    
    <div class="flex items-center gap-4 mb-8">
      <img 
        src="/logo.jpg" 
        alt="NZ Coffee Logo" 
        class="h-20 w-auto object-contain opacity-90" 
        width="80" 
        height="80"
      />
      <div class="h-[1px] w-12 bg-gray-800"></div>
    </div>

    <h1 class="font-serif text-5xl md:text-7xl leading-[1.1] text-white mb-6">
      The Taste You <br />
      <span class="italic text-gray-400">Never Forget</span>
    </h1>

    <p class="text-gray-400 leading-relaxed max-w-md mb-10 font-light text-sm md:text-base">
      Great coffee, even greater ambiance. Enjoy aromatic home-brewed coffee and delicacies, served with a side of nature ambiance.
    </p>

    <div class="flex flex-col sm:flex-row items-start sm:items-center gap-8">
      
      <button onclick="document.getElementById('booking-section').scrollIntoView({behavior: 'smooth'})" 
        class="bg-premium-gold text-black px-8 py-4 uppercase tracking-widest text-xs font-bold hover:bg-white transition-colors duration-500">
        Book a Table
      </button>
      
      <div class="flex items-center gap-5 border-l border-white/10 pl-6 h-full">
        
        <a href="https://www.instagram.com/nzcoffee.co/" target="_blank" rel="noopener noreferrer" aria-label="Visit Instagram" class="group text-gray-500 hover:text-premium-gold transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="group-hover:-translate-y-1 transition-transform">
            <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
            <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
            <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
          </svg>
        </a>

        <a href="https://www.tiktok.com/@nzcoffee" target="_blank" rel="noopener noreferrer" aria-label="Visit TikTok" class="group text-gray-500 hover:text-premium-gold transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="group-hover:-translate-y-1 transition-transform">
            <path d="M9 12a4 4 0 1 0 4 4V4a5 5 0 0 0 5 5"></path>
          </svg>
        </a>

        <a href="https://share.google/2eT1iLbitQZUL4p9i" target="_blank" rel="noopener noreferrer" aria-label="View on Google Maps" class="group text-gray-500 hover:text-premium-gold transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="group-hover:-translate-y-1 transition-transform">
            <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
            <circle cx="12" cy="10" r="3"></circle>
          </svg>
        </a>

      </div>

    </div>
  </div>
</main>