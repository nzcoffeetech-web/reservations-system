---
import Hero from '../components/Hero.astro';
import BookingMap from '../components/BookingMap.jsx';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>NZ Coffee | The Taste You Never Forget</title>
    
    <link rel="icon" type="image/png" href="/logo.jpg" />
    
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;1,400&family=Inter:wght@300;400;500&display=swap" rel="stylesheet">
  </head>
  <body class="bg-premium-black text-premium-text font-sans antialiased selection:bg-premium-gold selection:text-black">
    
    <nav class="absolute top-0 w-full z-50 px-6 py-6 md:px-12 flex justify-between items-center">
      
      <div class="text-center group cursor-pointer">
        <img 
          src="/logo.jpg" 
          alt="NZ Coffee" 
          class="h-16 w-auto object-contain hover:scale-105 transition-transform duration-300" 
        />
      </div>

      <div class="hidden md:flex gap-8 text-xs uppercase tracking-widest text-gray-400 font-medium">
        <a href="#" class="hover:text-white transition-colors">About us</a>
        <a href="#" class="hover:text-white transition-colors">Services</a>
        <a href="https://nzcoffee.work/menu" target="_blank" class="hover:text-white transition-colors">Menu</a>
        <a href="#" class="hover:text-white transition-colors">Our Team</a>
      </div>

      <button class="md:hidden text-premium-gold">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="4" x2="20" y1="12" y2="12"/><line x1="4" x2="20" y1="6" y2="6"/><line x1="4" x2="20" y1="18" y2="18"/></svg>
      </button>
    </nav>

    <Hero />

    <section id="booking-section" class="bg-premium-dark py-24 px-6 border-t border-white/5">
      <div class="max-w-6xl mx-auto">
        <div class="text-center mb-1">
          <h2 class="font-serif text-3xl md:text-4xl text-white mb-3">Reserve Your Spot</h2>
        </div>
        
        <BookingMap client:load />
      </div>
    </section>

    <footer class="bg-premium-black py-12 border-t border-white/5 text-center">
      <p class="font-serif text-xl text-white mb-2">NZ</p>
      <p class="text-[10px] text-gray-600 uppercase tracking-widest">&copy; 2026 NZ Coffee. Crafted for Exclusivity.</p>
    </footer>

  </body>
</html>