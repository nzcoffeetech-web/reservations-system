---
// 1. FORCE STATIC BUILD
export const prerender = true;

// 2. EXPANDED DATASET
export async function getStaticPaths() {
  const neighborhoods = [
    { slug: "country-homes", name: "Bandar Country Homes" },
    { slug: "anggun-city", name: "Anggun City" },
    { slug: "emerald-rawang", name: "Emerald Rawang" },
    { slug: "kampung-tanjung", name: "Kampung Tanjung" },
    { slug: "rawang-town", name: "Pusat Bandar Rawang" },
    { slug: "bukit-beruntung", name: "Bukit Beruntung" },
    { slug: "serendah", name: "Serendah" },      
    { slug: "sungai-buaya", name: "Sungai Buaya" }, 
    { slug: "kuang", name: "Kuang" },            
    { slug: "selayang", name: "Selayang" },      
    { slug: "batang-kali", name: "Batang Kali" } 
  ];

  const intents = [
    { 
      slug: "birthday-venue", 
      title: "Best Birthday Venue", 
      focus: "celebration",
      hook: "Make your special day unforgettable with our private rooms and custom arrangements.",
      menuHighlight: {
        name: "Nyonya Pie Tee Platter",
        desc: "Crispy golden pastry shells filled with savory shredded carrot & sengkuang. The perfect party starter.",
        price: "RM 7.90"
      }
    },
    { 
      slug: "family-dinner", 
      title: "Top Family Dinner Spot", 
      focus: "family",
      hook: "Spacious seating and a kid-friendly menu that the whole family will love.",
      menuHighlight: {
        name: "Golden Butter Chicken",
        desc: "Aromatic deep-fried chicken in our signature creamy buttery sauce. Served with rice or pasta.",
        price: "RM 16.50"
      }
    },
    { 
      slug: "private-meeting", 
      title: "Private Meeting Room Cafe", 
      focus: "business",
      hook: "Close the deal in peace. High-speed WiFi, quiet zones, and premium coffee.",
      menuHighlight: {
        name: "Signature Bebokol Latte",
        desc: "A local favorite. The perfect aromatic blend of Pandan, Gula Melaka, and Espresso.",
        price: "RM 14.00"
      }
    },
    { 
      slug: "romantic-dinner", 
      title: "Romantic Dinner Place", 
      focus: "couple",
      hook: "The perfect lighting and ambiance for a quiet, intimate evening together.",
      menuHighlight: {
        name: "Seared Smoked Duck",
        desc: "Extremely moist smoked duck breast served with colorful salad and creamy mashed potato.",
        price: "RM 33.50"
      }
    },
  ];

  return neighborhoods.flatMap((area) => 
    intents.map((intent) => ({
      params: { neighborhood: area.slug, intent: intent.slug },
      props: { area, intent },
    }))
  );
}

const otherMainCourses = [
  { name: "Grilled Lamb", desc: "Juicy tender lamb with mashed potato, onion rings and grilled pakchoy.", price: "RM 33.50" },
  { name: "Seafood Pasta", desc: "Shrimp, scallops, and mussels in a rich garlic sauce with fresh herbs.", price: "RM 24.50" },
  { name: "Smoked Duck Masak Lemak", desc: "Spicy traditional dish with bird's eye chili cream sauce. Served with rice.", price: "RM 31.50" }
];

const { area, intent } = Astro.props;

if (!intent) { throw new Error("Intent data missing"); }

const fullMenu = [intent.menuHighlight, ...otherMainCourses];

import BookingMap from '../../../components/BookingMap.jsx';
import Layout from '../../../layouts/Layout.astro';
import Footer from '../../../components/Footer.astro'; // <--- IMPORT FOOTER HERE
---

<Layout title={`${intent.title} for ${area.name} Residents | NZ Coffee`}>
  
  <head slot="head">
    <meta name="description" content={`Looking for the ${intent.title.toLowerCase()} near ${area.name}? NZ Coffee offers private rooms, amazing food, and a nature vibe worth the drive.`} />
    <style>
      .scrollbar-hide::-webkit-scrollbar { display: none; }
      .scrollbar-hide { -ms-overflow-style: none; scrollbar-width: none; }
    </style>
  </head>

  <main class="bg-[#0F0F0F] min-h-screen text-white font-sans selection:bg-premium-gold selection:text-black">
    
    <nav class="absolute top-0 left-0 w-full z-50 py-6 px-6 flex justify-center">
      <img src="/logo.jpg" alt="NZ Coffee" class="h-16 w-auto opacity-90 hover:opacity-100 transition-opacity drop-shadow-lg" />
    </nav>

    <div class="fixed bottom-6 left-6 right-6 z-50 md:hidden animate-in slide-in-from-bottom-4 duration-700">
      <button 
        onclick="document.getElementById('book-now').scrollIntoView({behavior: 'smooth'})" 
        class="w-full bg-premium-gold text-black font-bold uppercase tracking-widest text-xs py-4 rounded shadow-[0_0_20px_rgba(192,141,93,0.4)] border border-white/20"
      >
        Book Table Now
      </button>
    </div>

    <div class="relative pt-40 pb-16 px-6 text-center border-b border-white/5 overflow-hidden">
      <div class="absolute top-0 left-1/2 -translate-x-1/2 w-[500px] h-[500px] bg-premium-gold/10 rounded-full blur-[100px] pointer-events-none"></div>
      
      <div class="relative z-10 max-w-4xl mx-auto">
        <span class="inline-block py-1 px-3 rounded-full bg-white/5 border border-white/10 text-premium-gold text-[10px] font-bold uppercase tracking-[0.2em] mb-6 backdrop-blur-md">
          Serving {area.name} & Surrounds
        </span>
        <h1 class="text-4xl md:text-7xl font-serif text-white mb-6 leading-[1.1]">
          The {intent.title} <br/> near <span class="text-transparent bg-clip-text bg-gradient-to-r from-premium-gold to-yellow-200">{area.name}</span>
        </h1>
        <p class="text-gray-400 text-lg md:text-xl max-w-2xl mx-auto font-light leading-relaxed">
          {intent.hook} A premium dining experience worth the trip.
        </p>
      </div>
    </div>

    <div class="max-w-7xl mx-auto py-16 px-6 grid lg:grid-cols-12 gap-16 items-start">
      
      <div class="lg:col-span-5 relative group order-2 lg:order-1 flex justify-center">
