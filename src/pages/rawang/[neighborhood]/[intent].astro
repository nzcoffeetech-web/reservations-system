      </div>

      <div class="lg:col-span-7 order-1 lg:order-2">
        <h2 class="text-3xl md:text-4xl font-serif text-white mb-8">Why {area.name} locals drive to us?</h2>
        
        <div class="space-y-6 mb-12">
