                </div>
                
                <div>
                  <h3 class="text-xl font-serif text-white mb-3 leading-tight group-hover:text-premium-gold transition-colors">{item.name}</h3>
                  <p class="text-gray-500 text-xs leading-relaxed line-clamp-3">{item.desc}</p>
                </div>

                <div class="mt-4 pt-4 border-t border-white/5 flex justify-between items-end">
