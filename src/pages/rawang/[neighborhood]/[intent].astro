              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
            </div>
            <div>
              <h3 class="font-bold text-white text-lg">Destination Dining</h3>
              <p class="text-sm text-gray-400">Located at Kampung Tanjung. A perfect short road trip for premium vibes.</p>
            </div>
          </div>
          
          <div class="flex gap-5 group">
             <div class="w-12 h-12 rounded-full bg-white/5 border border-white/10 flex items-center justify-center shrink-0 text-premium-gold group-hover:bg-premium-gold group-hover:text-black transition-colors">
               <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="7"/><path d="M8.21 13.89L7 23l5-3 5 3-1.21-9.12"/></svg>
            </div>
            <div>
              <h3 class="font-bold text-white text-lg">Private & Exclusive</h3>
              <p class="text-sm text-gray-400">{intent.focus === 'business' ? 'Soundproofed areas with high-speed WiFi.' : 'Private VIP rooms (Min 8 Pax) for loud celebrations.'}</p>
            </div>
          </div>
        </div>

        <div class="relative">
          <div class="flex items-center justify-between mb-4">
             <span class="text-premium-gold text-[10px] font-bold uppercase tracking-widest">Signature Mains</span>
             <span class="text-gray-600 text-[10px] uppercase tracking-widest animate-pulse">Swipe →</span>
          </div>

          <div class="flex overflow-x-auto snap-x snap-mandatory gap-4 pb-4 -mx-4 px-4 md:mx-0 md:px-0 scrollbar-hide">
            
            {fullMenu.map((item, index) => (
              <div key={index} class="snap-center shrink-0 w-[240px] md:w-[260px] bg-[#141414] border border-white/10 rounded-xl p-6 relative group hover:border-premium-gold/50 transition-colors flex flex-col justify-between h-[220px]">
                
