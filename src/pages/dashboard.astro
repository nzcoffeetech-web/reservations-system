---
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>NZ Coffee Intelligence</title>
  <link rel="icon" type="image/jpeg" href="/logo.jpg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,600;1,400&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet" />
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4/dist/chart.umd.min.js"></script>
  <style>
    :root {
      --bg:          #0a0a0b;
      --surface:     #141416;
      --surface-2:   #1c1c20;
      --border:      #2a2a2e;
      --text:        #f5f3ee;
      --text-muted:  #8a8a92;
      --accent:      #c8794a;
      --accent-soft: rgba(200,121,74,0.15);
    }

    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: 'Inter', sans-serif;
      background: var(--bg);
      color: var(--text);
      min-height: 100vh;
    }

    /* ── Login ─────────────────────────────────────────── */
    #login-view {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      background: var(--bg);
      padding: 1rem;
    }
    .login-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 2.5rem 2rem;
      width: 100%;
      max-width: 400px;
      box-shadow: 0 8px 48px rgba(0,0,0,0.5);
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.5rem;
    }
    .nz-badge {
      width: 56px;
      height: 56px;
      border-radius: 50%;
      background: var(--surface-2);
      border: 1.5px solid var(--accent);
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: 'Playfair Display', serif;
      font-size: 1.25rem;
      color: var(--accent);
      font-weight: 600;
      margin-bottom: 0.5rem;
      flex-shrink: 0;
    }
    .login-card .brand-title {
      font-family: 'Playfair Display', serif;
      font-size: 1.5rem;
      color: var(--text);
      text-align: center;
    }
    .login-card .brand-tagline {
      font-size: 0.8rem;
      color: var(--text-muted);
      text-align: center;
      letter-spacing: 0.05em;
      margin-bottom: 1rem;
    }
    .login-form { display: flex; flex-direction: column; gap: 0.75rem; width: 100%; }
    .login-form input[type="email"] {
      width: 100%;
      padding: 0.75rem 1rem;
      border: 1px solid var(--border);
      border-radius: 8px;
      font-size: 0.95rem;
      font-family: 'Inter', sans-serif;
      background: var(--surface-2);
      color: var(--text);
      outline: none;
      transition: border-color 0.2s;
    }
    .login-form input[type="email"]:focus { border-color: var(--accent); }
    .login-form button {
      padding: 0.75rem 1rem;
      background: var(--accent);
      color: #fff;
      border: none;
      border-radius: 8px;
      font-size: 0.9rem;
      font-weight: 600;
      cursor: pointer;
      font-family: 'Inter', sans-serif;
      transition: opacity 0.2s;
    }
    .login-form button:hover { opacity: 0.85; }
    .login-form button:disabled { opacity: 0.4; cursor: default; }
    .login-status { font-size: 0.85rem; color: #6ab06a; text-align: center; min-height: 1.2em; }
    .login-status.error { color: #f87171; }

    /* ── Sidebar layout ────────────────────────────────── */
    #dashboard-view { display: flex; min-height: 100vh; }

    .sidebar {
      width: 240px;
      min-height: 100vh;
      background: var(--surface);
      border-right: 1px solid var(--border);
      position: fixed;
      top: 0; left: 0;
      display: flex;
      flex-direction: column;
      z-index: 50;
    }
    .sidebar-brand {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      padding: 1.25rem 1.25rem 1rem;
      border-bottom: 1px solid var(--border);
    }
    .nz-badge-sm {
      width: 36px;
      height: 36px;
      border-radius: 50%;
      background: var(--surface-2);
      border: 1.5px solid var(--accent);
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: 'Playfair Display', serif;
      font-size: 0.85rem;
      color: var(--accent);
      font-weight: 600;
      flex-shrink: 0;
    }
    .sidebar-wordmark { display: flex; flex-direction: column; overflow: hidden; }
    .sidebar-wordmark .brand-name {
      font-family: 'Playfair Display', serif;
      font-size: 0.82rem;
      color: var(--text);
      line-height: 1.3;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .sidebar-wordmark .brand-sub {
      font-size: 0.62rem;
      color: var(--text-muted);
      letter-spacing: 0.03em;
    }
    .sidebar-nav { padding: 1.25rem 0.75rem; flex: 1; overflow-y: auto; }
    .sidebar-nav-label {
      font-size: 0.62rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      color: var(--text-muted);
      padding: 0 0.5rem;
      margin-bottom: 0.5rem;
    }
    .nav-link {
      display: flex;
      align-items: center;
      gap: 0.6rem;
      padding: 0.55rem 0.75rem;
      border-radius: 8px;
      font-size: 0.82rem;
      color: var(--text-muted);
      text-decoration: none;
      transition: all 0.15s;
      cursor: pointer;
      border-left: 2px solid transparent;
      margin-bottom: 0.1rem;
    }
    .nav-link:hover { background: var(--surface-2); color: var(--text); }
    .nav-link.active {
      background: var(--accent-soft);
      color: var(--accent);
      border-left-color: var(--accent);
      font-weight: 500;
    }
    .nav-icon { font-size: 0.9rem; opacity: 0.7; width: 16px; text-align: center; flex-shrink: 0; }
    .sidebar-footer {
      padding: 1rem 1.25rem;
      border-top: 1px solid var(--border);
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
    }
    .sidebar-user {
      font-size: 0.75rem;
      color: var(--text-muted);
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    .signout-btn {
      padding: 0.35rem 0.75rem;
      border: 1px solid var(--border);
      background: transparent;
      color: var(--text-muted);
      font-size: 0.78rem;
      border-radius: 6px;
      cursor: pointer;
      font-family: 'Inter', sans-serif;
      transition: all 0.15s;
      text-align: left;
      width: 100%;
    }
    .signout-btn:hover { border-color: #f87171; color: #f87171; }

    /* ── Main area ─────────────────────────────────────── */
    .main-area {
      margin-left: 240px;
      flex: 1;
      display: flex;
      flex-direction: column;
      min-height: 100vh;
      min-width: 0;
    }

    /* ── Top bar ───────────────────────────────────────── */
    .topbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 1rem 1.75rem;
      border-bottom: 1px solid var(--border);
      flex-wrap: wrap;
      gap: 0.75rem;
      background: var(--bg);
      position: sticky;
      top: 0;
      z-index: 40;
    }
    .topbar-title {
      font-size: 1rem;
      font-weight: 600;
      color: var(--text);
    }
    .topbar-right { display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap; }

    /* Date filter — segmented pills */
    .date-pills {
      display: flex;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 8px;
      overflow: hidden;
    }
    .df-btn {
      padding: 0.38rem 0.7rem;
      border: none;
      border-right: 1px solid var(--border);
      background: transparent;
      color: var(--text-muted);
      font-size: 0.76rem;
      cursor: pointer;
      font-family: 'Inter', sans-serif;
      transition: all 0.15s;
      white-space: nowrap;
    }
    .df-btn:last-child { border-right: none; }
    .df-btn:hover { background: var(--surface-2); color: var(--text); }
    .df-btn.active { background: var(--accent-soft); color: var(--accent); font-weight: 600; }

    .icon-btn {
      padding: 0.38rem 0.65rem;
      border: 1px solid var(--border);
      background: transparent;
      color: var(--text-muted);
      font-size: 0.85rem;
      border-radius: 7px;
      cursor: pointer;
      font-family: 'Inter', sans-serif;
      transition: all 0.15s;
    }
    .icon-btn:hover { border-color: var(--accent); color: var(--accent); }

    /* Custom date row */
    .custom-date-row {
      padding: 0.5rem 1.75rem 0.75rem;
      display: flex;
      align-items: center;
      gap: 1rem;
      flex-wrap: wrap;
      background: var(--bg);
      border-bottom: 1px solid var(--border);
    }
    .custom-date-row label {
      display: flex;
      align-items: center;
      gap: 0.4rem;
      font-size: 0.8rem;
      color: var(--text-muted);
    }
    .custom-date-row input[type="date"] {
      padding: 0.25rem 0.5rem;
      border: 1px solid var(--border);
      background: var(--surface-2);
      color: var(--text);
      border-radius: 5px;
      font-family: 'Inter', sans-serif;
      font-size: 0.8rem;
    }
    .custom-date-row button {
      padding: 0.28rem 0.75rem;
      background: var(--accent);
      color: #fff;
      border: none;
      border-radius: 6px;
      font-size: 0.8rem;
      font-weight: 600;
      cursor: pointer;
      font-family: 'Inter', sans-serif;
    }

    /* ── Error banner ──────────────────────────────────── */
    .error-banner {
      background: rgba(248,71,71,0.07);
      border-bottom: 1px solid rgba(248,71,71,0.25);
      padding: 0.75rem 1.75rem;
      display: flex;
      align-items: center;
      gap: 1rem;
      flex-wrap: wrap;
    }
    .error-banner span { color: #f87171; font-size: 0.85rem; flex: 1; }
    .error-banner button {
      padding: 0.3rem 0.75rem;
      background: transparent;
      border: 1px solid rgba(248,71,71,0.4);
      color: #f87171;
      border-radius: 6px;
      font-size: 0.8rem;
      cursor: pointer;
      font-family: 'Inter', sans-serif;
      white-space: nowrap;
    }

    /* ── Main content ──────────────────────────────────── */
    .dash-main {
      padding: 1.75rem;
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
    }

    /* ── KPI strip ─────────────────────────────────────── */
    .kpi-strip {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 1rem;
    }
    @media (max-width: 900px) { .kpi-strip { grid-template-columns: repeat(2, 1fr); } }
    @media (max-width: 500px) { .kpi-strip { grid-template-columns: 1fr; } }
    .kpi-card {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 1.5rem;
      display: flex;
      flex-direction: column;
      gap: 0.2rem;
      box-shadow: 0 1px 8px rgba(0,0,0,0.3);
    }
    .kpi-label {
      font-size: 0.7rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--text-muted);
    }
    .kpi-num {
      font-family: 'Playfair Display', serif;
      font-size: 2.2rem;
      font-weight: 600;
      color: var(--text);
      line-height: 1;
      margin: 0.25rem 0 0.1rem;
    }
    .kpi-meaning { font-size: 0.79rem; color: var(--text-muted); }

    /* ── Pillars ───────────────────────────────────────── */
    .pillars-grid {
      display: grid;
      grid-template-columns: 1fr 1fr 1.3fr;
      gap: 1rem;
      align-items: start;
    }
    @media (max-width: 1100px) { .pillars-grid { grid-template-columns: 1fr 1fr; } }
    @media (max-width: 700px)  { .pillars-grid { grid-template-columns: 1fr; } }
    .pillar {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 1.5rem;
      display: flex;
      flex-direction: column;
      gap: 1rem;
      box-shadow: 0 1px 8px rgba(0,0,0,0.3);
    }
    .pillar-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.5rem;
      flex-wrap: wrap;
    }
    .pillar-header h2 { font-size: 0.92rem; font-weight: 600; color: var(--text); }
    .badge-tag {
      font-size: 0.64rem;
      font-weight: 500;
      background: var(--surface-2);
      color: var(--text-muted);
      padding: 0.18rem 0.55rem;
      border-radius: 99px;
      border: 1px solid var(--border);
      white-space: nowrap;
    }
    .badge-tag.period { color: var(--accent); border-color: rgba(200,121,74,0.3); background: var(--accent-soft); }

    /* ── Trend ─────────────────────────────────────────── */
    .trend-summary {
      font-size: 0.83rem;
      color: var(--text);
      background: var(--surface-2);
      border-left: 2px solid var(--accent);
      border-radius: 0 8px 8px 0;
      padding: 0.65rem 0.9rem;
      line-height: 1.5;
    }
    .trend-cancel { font-size: 0.78rem; color: var(--text-muted); }
    .chart-wrap { position: relative; height: 200px; }

    /* ── Segments ──────────────────────────────────────── */
    .seg-tabs {
      display: flex;
      background: var(--surface-2);
      border: 1px solid var(--border);
      border-radius: 8px;
      overflow: hidden;
      width: fit-content;
    }
    .seg-tab {
      padding: 0.3rem 0.85rem;
      border: none;
      border-right: 1px solid var(--border);
      background: transparent;
      color: var(--text-muted);
      font-size: 0.76rem;
      cursor: pointer;
      font-family: 'Inter', sans-serif;
      transition: all 0.15s;
    }
    .seg-tab:last-child { border-right: none; }
    .seg-tab:hover { background: var(--surface); color: var(--text); }
    .seg-tab.active { background: var(--accent-soft); color: var(--accent); font-weight: 600; }
    .seg-cards { display: flex; flex-direction: column; gap: 0.55rem; }
    .seg-card {
      border: 1px solid var(--border);
      background: var(--surface-2);
      border-radius: 10px;
      padding: 0.85rem;
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
    }
    .seg-row { display: flex; justify-content: space-between; align-items: baseline; gap: 0.5rem; }
    .seg-label { font-weight: 600; font-size: 0.86rem; color: var(--text); }
    .seg-count { font-size: 0.74rem; color: var(--text-muted); }
    .seg-meaning { font-size: 0.76rem; color: var(--text-muted); font-style: italic; }
    .seg-bar-track {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 3px;
      height: 4px;
      margin: 0.1rem 0;
    }
    .seg-bar { background: var(--accent); border-radius: 3px; height: 4px; transition: width 0.4s; }
    .seg-value { font-size: 0.82rem; font-weight: 600; color: var(--accent); }
    .seg-action { font-size: 0.75rem; color: var(--text-muted); }
    .rfm-dot { display: inline-block; width: 8px; height: 8px; border-radius: 50%; margin-right: 5px; vertical-align: middle; }
    .rfm-score { font-size: 0.74rem; color: var(--text-muted); }

    /* ── Leads ─────────────────────────────────────────── */
    .leads-filter-row { display: flex; gap: 0.4rem; flex-wrap: wrap; }
    .lf-btn {
      padding: 0.28rem 0.65rem;
      border: 1px solid var(--border);
      border-radius: 99px;
      font-size: 0.74rem;
      cursor: pointer;
      background: transparent;
      color: var(--text-muted);
      font-family: 'Inter', sans-serif;
      transition: all 0.15s;
      white-space: nowrap;
    }
    .lf-btn:hover { border-color: var(--accent); color: var(--text); }
    .lf-btn.active { background: var(--accent-soft); border-color: rgba(200,121,74,0.4); color: var(--accent); font-weight: 600; }
    .lf-btn.hot { border-color: rgba(200,121,74,0.35); color: var(--accent); }
    .lf-btn.hot.active { background: var(--accent-soft); }
    .table-wrap { overflow-x: auto; }
    table { width: 100%; border-collapse: collapse; font-size: 0.81rem; }
    th {
      text-align: left;
      padding: 0.5rem 0.65rem;
      border-bottom: 1px solid var(--border);
      color: var(--text-muted);
      font-weight: 600;
      font-size: 0.7rem;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      cursor: pointer;
      white-space: nowrap;
      user-select: none;
    }
    th:hover { color: var(--accent); }
    th.sorted-asc::after  { content: ' ↑'; color: var(--accent); }
    th.sorted-desc::after { content: ' ↓'; color: var(--accent); }
    td {
      padding: 0.5rem 0.65rem;
      border-bottom: 1px solid var(--border);
      color: var(--text);
      vertical-align: middle;
    }
    tr:last-child td { border-bottom: none; }
    tr:hover td { background: var(--surface-2); }
    .hot-row td { background: rgba(200,121,74,0.06) !important; }
    .hot-row:hover td { background: rgba(200,121,74,0.12) !important; }
    td.num { text-align: right; font-variant-numeric: tabular-nums; }
    td.mono { font-family: 'Courier New', monospace; font-size: 0.77rem; color: var(--text-muted); }
    .lead-tag {
      display: inline-block;
      padding: 0.14rem 0.55rem;
      border-radius: 99px;
      font-size: 0.7rem;
      font-weight: 500;
    }
    .empty-td { text-align: center; color: var(--text-muted); padding: 1.5rem; }

    /* ── Pagination ────────────────────────────────────── */
    .leads-pagination {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.75rem;
      padding-top: 0.75rem;
      border-top: 1px solid var(--border);
    }
    .leads-pagination button {
      padding: 0.3rem 0.75rem;
      border: 1px solid var(--border);
      border-radius: 6px;
      background: transparent;
      color: var(--text-muted);
      font-size: 0.77rem;
      cursor: pointer;
      font-family: 'Inter', sans-serif;
      transition: all 0.15s;
    }
    .leads-pagination button:hover:not(:disabled) { border-color: var(--accent); color: var(--accent); }
    .leads-pagination button:disabled { opacity: 0.25; cursor: default; }
    .page-info { font-size: 0.77rem; color: var(--text-muted); min-width: 8rem; text-align: center; }

    /* ── Acquisition note ──────────────────────────────── */
    .acq-note {
      font-size: 0.79rem;
      color: var(--text-muted);
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 0.75rem 1rem;
    }

    /* ── Misc ──────────────────────────────────────────── */
    .empty-state { color: var(--text-muted); font-size: 0.84rem; text-align: center; padding: 1.5rem 0; }

    /* ── Responsive: sidebar collapses on narrow screens ── */
    @media (max-width: 768px) {
      #dashboard-view { flex-direction: column; }
      .sidebar {
        position: relative;
        width: 100%;
        min-height: auto;
        border-right: none;
        border-bottom: 1px solid var(--border);
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
        padding: 0.75rem 1rem;
        flex-wrap: wrap;
        gap: 0.5rem;
      }
      .sidebar-brand { padding: 0; border-bottom: none; flex: 1; }
      .sidebar-nav, .sidebar-footer { display: none; }
      .main-area { margin-left: 0; }
      .topbar { position: relative; }
    }
  </style>
</head>
<body>

<!-- ═══════════════════════ LOGIN VIEW ═══════════════════════════ -->
<div id="login-view">
  <div class="login-card">
    <div class="nz-badge">NZ</div>
    <h1 class="brand-title">NZ Coffee Intelligence</h1>
    <p class="brand-tagline">The taste you never forget</p>
    <div class="login-form">
      <input type="email" id="email-input" placeholder="your@email.com" autocomplete="email" />
      <button id="magic-link-btn">Send magic link</button>
    </div>
    <p id="login-status" class="login-status"></p>
  </div>
</div>

<!-- ═══════════════════════ DASHBOARD VIEW ═══════════════════════ -->
<div id="dashboard-view" style="display:none">

  <!-- Sidebar -->
  <aside class="sidebar">
    <div class="sidebar-brand">
      <div class="nz-badge-sm">NZ</div>
      <div class="sidebar-wordmark">
        <span class="brand-name">NZ Coffee Intelligence</span>
        <span class="brand-sub">The taste you never forget</span>
      </div>
    </div>
    <nav class="sidebar-nav">
      <div class="sidebar-nav-label">MAIN</div>
      <a class="nav-link active" href="#kpi-section"><span class="nav-icon">◈</span> Overview</a>
      <a class="nav-link" href="#trend-section"><span class="nav-icon">↗</span> Booking Trends</a>
      <a class="nav-link" href="#segments-section"><span class="nav-icon">◉</span> Segments</a>
      <a class="nav-link" href="#leads-section"><span class="nav-icon">≡</span> Customers &amp; Leads</a>
    </nav>
    <div class="sidebar-footer">
      <span id="sidebar-user-email" class="sidebar-user"></span>
      <button id="signout-btn" class="signout-btn">Sign out</button>
    </div>
  </aside>

  <!-- Main area -->
  <div class="main-area">

    <!-- Top bar -->
    <div class="topbar">
      <span class="topbar-title">Dashboard</span>
      <div class="topbar-right">
        <div class="date-pills" id="date-filter-strip">
          <button class="df-btn active" data-mode="month">This Month</button>
          <button class="df-btn" data-mode="prevmonth">Prev Month</button>
          <button class="df-btn" data-mode="90d">Last 90d</button>
