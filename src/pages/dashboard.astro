        </div>
        <div class="kpi-card" id="kpi-signal">
          <div class="kpi-num">—</div>
          <div class="kpi-label">Online vs walk-in spend</div>
          <div class="kpi-meaning">Loading…</div>
        </div>
        <div class="kpi-card" id="kpi-revenue">
          <div class="kpi-num">—</div>
          <div class="kpi-label">Lifetime revenue</div>
          <div class="kpi-meaning">Loading…</div>
        </div>
        <div class="kpi-card" id="kpi-bookings">
          <div class="kpi-num">—</div>
          <div class="kpi-label">Confirmed bookings</div>
          <div class="kpi-meaning">Loading…</div>
