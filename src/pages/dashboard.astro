    </main>
  </div>
</div>

<!-- ═══════════════════════ SCRIPT ═══════════════════════════════ -->
<script type="module">
import { createClient } from 'https://esm.sh/@supabase/supabase-js@2';
(function () {
  /* ── Config ─────────────────────────────────────────── */
  const SUPA_URL  = 'https://vjtvuhtyilxnepqtppoq.supabase.co';
  const SUPA_KEY  = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InZqdHZ1aHR5aWx4bmVwcXRwcG9xIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NjkwMDIzMTIsImV4cCI6MjA4NDU3ODMxMn0.hIHr6XZfwRwPVHYSfkYvvtpQ5YfMnqW8sVeWyGWvK4o';
  const ALLOWED   = ['nzcoffee.tech@gmail.com', 'nzcoffeeco@gmail.com'];

  /* ── State ──────────────────────────────────────────── */
  const PAGE_SIZE = 100;

  let leads       = [];       // current page only
  let leadsPage   = 0;
  let leadsTotal  = 0;
  let kpiSummary  = {};
  let segCounts   = [];       // from v_segment_counts (pre-aggregated)
  let rfmCounts   = [];       // from v_rfm_counts     (pre-aggregated)
  let bookings    = [];
  let dateMode    = 'month';
  let customFrom  = null;
  let customTo    = null;
  let segView     = 'plain';
  let leadsFilter = 'all';
  let sortCol     = 'total_spent';
  let sortAsc     = false;
  let trendChart  = null;

  /* ── Supabase client ────────────────────────────────── */
  const db = createClient(SUPA_URL, SUPA_KEY);

  /* ══════════════════════════════════════════════════════
     AUTH — the ONLY code path that reveals the dashboard
     is a resolved, whitelisted session object.
  ══════════════════════════════════════════════════════ */
  async function initAuth() {
    const { data: { session } } = await db.auth.getSession();
    if (session) revealDashboard(session);

    db.auth.onAuthStateChange((event, session) => {
      if (event === 'SIGNED_IN' && session !== null) {
        revealDashboard(session);
      }
      if (event === 'SIGNED_OUT') {
        showLogin();
      }
    });
  }

  function revealDashboard(session) {
    if (!session || !session.user) { showLogin(); return; }
    if (!ALLOWED.includes(session.user.email)) {
      db.auth.signOut();
      setLoginMsg('Not authorised for this dashboard.', true);
      return;
    }
    document.getElementById('login-view').style.display    = 'none';
    document.getElementById('dashboard-view').style.display = 'flex';
    document.getElementById('sidebar-user-email').textContent = session.user.email;
    loadData();
  }

  function showLogin() {
    document.getElementById('login-view').style.display    = 'flex';
    document.getElementById('dashboard-view').style.display = 'none';
  }

  async function sendMagicLink() {
    const emailEl = document.getElementById('email-input');
    const email   = emailEl.value.trim();
    if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
      setLoginMsg('Enter a valid email address.', true);
      return;
    }
    const btn = document.getElementById('magic-link-btn');
    btn.disabled    = true;
    btn.textContent = 'Sending…';
    const { error } = await db.auth.signInWithOtp({
      email,
      options: { emailRedirectTo: 'https://nzcoffee.work/dashboard' }
    });
    btn.disabled    = false;
    btn.textContent = 'Send magic link';
    if (error) { setLoginMsg(error.message, true); return; }
    setLoginMsg('Check your inbox — magic link sent.');
  }

  function setLoginMsg(msg, isErr = false) {
    const el = document.getElementById('login-status');
    el.textContent = msg;
    el.className   = 'login-status' + (isErr ? ' error' : '');
  }

  async function handleSignOut() {
    await db.auth.signOut();
  }

  /* ══════════════════════════════════════════════════════
     DATA
  ══════════════════════════════════════════════════════ */
  async function loadData() {
    hideError();
    leadsPage = 0;

    const [r0, r1, r2, r3, r4] = await Promise.all([
      db.from('v_kpi_summary').select('*').single(),
      db.from('v_segment_counts').select('*'),
      db.from('v_rfm_counts').select('*'),
      db.from('calendly_bookings').select('*'),
      fetchLeadsPage(0),
    ]);

    const errs = [
      r0.error && `v_kpi_summary: ${r0.error.message}`,
      r1.error && `v_segment_counts: ${r1.error.message}`,
      r2.error && `v_rfm_counts: ${r2.error.message}`,
      r3.error && `calendly_bookings: ${r3.error.message}`,
      r4.error && `v_leads: ${r4.error.message}`,
    ].filter(Boolean);

    if (errs.length) showError(errs.join(' | '));

    kpiSummary = r0.data || {};
    segCounts  = r1.data || [];
    rfmCounts  = r2.data || [];
    bookings   = r3.data || [];
    leads      = r4.data || [];
    leadsTotal = r4.count ?? 0;

    render();
  }

  /* Build a paginated, server-sorted, server-filtered leads query */
  function fetchLeadsPage(page) {
    const from = page * PAGE_SIZE;
    const to   = from + PAGE_SIZE - 1;

    let q = db
      .from('v_leads')
      .select('phone_e164, name, total_spent, total_visits, last_visit, total_bookings, lead_type, utm_source',
              { count: 'exact' })
      .order(sortCol, { ascending: sortAsc })
      .range(from, to);

    if (leadsFilter === 'bookers') q = q.eq('lead_type', 'customer + booker');
    else if (leadsFilter === 'walkins') q = q.eq('lead_type', 'customer (walk-in)');
    else if (leadsFilter === 'hot')     q = q.eq('lead_type', 'booked, no StoreHub match');

    return q;
  }

  function showError(msg) {
    document.getElementById('error-banner').style.display = 'flex';
    document.getElementById('error-msg').textContent      = msg;
  }
  function hideError() {
    document.getElementById('error-banner').style.display = 'none';
  }

  /* ══════════════════════════════════════════════════════
     DATE HELPERS
  ══════════════════════════════════════════════════════ */
  function getDateRange() {
    const today = new Date();
    today.setHours(0, 0, 0, 0);
    if (dateMode === 'month') {
      return { from: new Date(today.getFullYear(), today.getMonth(), 1),
               to:   new Date(today.getFullYear(), today.getMonth() + 1, 0) };
    }
    if (dateMode === 'prevmonth') {
      return { from: new Date(today.getFullYear(), today.getMonth() - 1, 1),
               to:   new Date(today.getFullYear(), today.getMonth(), 0) };
    }
    if (dateMode === '90d') {
      const from = new Date(today);
      from.setDate(from.getDate() - 90);
      return { from, to: today };
    }
    if (dateMode === 'custom' && customFrom && customTo) {
      return { from: new Date(customFrom), to: new Date(customTo + 'T23:59:59') };
    }
    return { from: null, to: null };
  }

  /* Robustly read booking date regardless of column name */
  function bookingDate(b) {
    if (!b.event_start) return null;
    const d = new Date(b.event_start);
    return isNaN(d) ? null : d;
  }

  function isCanceled(b) {
    return b.canceled === true;
  }

  function bookingPax(b) {
    return b.pax == null ? 0 : Number(b.pax);
  }

  /* ══════════════════════════════════════════════════════
     FORMAT HELPERS
  ══════════════════════════════════════════════════════ */
  function fmtRM(n) {
    return 'RM ' + Number(n || 0).toLocaleString('en-MY', { maximumFractionDigits: 0 });
  }

  function fmtDate(d) {
    if (!d) return '—';
    const dt = typeof d === 'string' ? new Date(d) : d;
    if (isNaN(dt)) return '—';
    return dt.toLocaleDateString('en-MY', { day: 'numeric', month: 'short', year: 'numeric' });
  }

  function fmtMonth(key) {
    const [y, m] = key.split('-');
    return new Date(+y, +m - 1, 1)
      .toLocaleDateString('en-MY', { month: 'short', year: '2-digit' });
  }

  /* ══════════════════════════════════════════════════════
     RENDER
  ══════════════════════════════════════════════════════ */
  function render() {
    renderKPI();
    renderTrend();
    renderSegments();
    renderLeads();
    renderAcquisition();
  }

  /* ── KPI ───────────────────────────────────────────── */
  function setKPI(id, num, label, meaning) {
    const el = document.getElementById(id);
    if (!el) return;
    el.querySelector('.kpi-num').textContent    = num;
    el.querySelector('.kpi-label').textContent  = label;
    el.querySelector('.kpi-meaning').textContent = meaning;
  }

  function renderKPI() {
    const k = kpiSummary;

    /* 1. Total customers — from v_kpi_summary (full table count) */
    const nCustomers = Number(k.total_customers || 0);
    setKPI('kpi-customers',
      nCustomers.toLocaleString(),
      'Total customers',
      `${nCustomers.toLocaleString()} people in your database`);

    /* 2. Booking value signal — pre-computed averages from v_kpi_summary */
    const avgB = Number(k.avg_booker_spend || 0);
    const avgW = Number(k.avg_walkin_spend || 0);
    if (avgB > 0 && avgW > 0) {
      const mult = (avgB / avgW).toFixed(1);
      setKPI('kpi-signal', `${mult}×`,
        'Online booker vs walk-in',
        `Customers who book online spend ${mult}× more than walk-ins`);
    } else if (avgB > 0) {
      setKPI('kpi-signal', fmtRM(avgB), 'Avg online booker spend',
        `Average across online booking customers`);
    } else {
      setKPI('kpi-signal', '—', 'Online vs walk-in spend',
        'Need both booker + walk-in data to compare');
    }

    /* 3. Lifetime revenue — summed in SQL */
    setKPI('kpi-revenue', fmtRM(k.lifetime_revenue), 'Lifetime revenue',
      `All-time spend across ${nCustomers.toLocaleString()} customers`);

    /* 4. Confirmed bookings (date-filtered from in-memory bookings) */
    const range = getDateRange();
    const confirmed = bookings.filter(b => {
      if (isCanceled(b)) return false;
      const d = bookingDate(b);
      if (!d) return false;
      if (range.from && d < range.from) return false;
      if (range.to   && d > range.to)   return false;
      return true;
    });
    const periodLabel = { month: 'this month', prevmonth: 'last month',
      '90d': 'last 90 days', all: 'all time', custom: 'selected range' }[dateMode] || 'this period';
    setKPI('kpi-bookings', confirmed.length.toString(), 'Confirmed bookings',
      `Bookings that went ahead — ${periodLabel}`);
  }

  /* ── Trend ─────────────────────────────────────────── */
  function renderTrend() {
    const confirmed = bookings.filter(b => !isCanceled(b));

    /* group by YYYY-MM */
    const byMonth = {};
    confirmed.forEach(b => {
      const d = bookingDate(b);
      if (!d) return;
      const key = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}`;
      if (!byMonth[key]) byMonth[key] = { count: 0, pax: 0 };
      byMonth[key].count++;
      byMonth[key].pax += bookingPax(b);
    });

    const keys    = Object.keys(byMonth).sort();
    const last12  = keys.slice(-12);

    /* trend sentence */
    const summaryEl = document.getElementById('trend-summary');
    if (keys.length >= 6) {
      const r = keys.slice(-4, -1);   /* last 3 complete months */
      const p = keys.slice(-7, -4);
      if (r.length === 3 && p.length === 3) {
        const rAvg = r.reduce((s, k) => s + byMonth[k].count, 0) / 3;
        const pAvg = p.reduce((s, k) => s + byMonth[k].count, 0) / 3;
        if (pAvg > 0) {
          const pct = Math.round(((rAvg - pAvg) / pAvg) * 100);
          const dir = pct >= 0 ? 'up' : 'down';
          summaryEl.textContent =
            `Bookings are ${dir} ${Math.abs(pct)}% vs the previous 3-month average ` +
            `(${Math.round(rAvg)} vs ${Math.round(pAvg)} per month).`;
        } else {
          summaryEl.textContent = `${confirmed.length} confirmed bookings on record.`;
        }
      }
    } else if (keys.length > 0) {
      summaryEl.textContent = `${confirmed.length} confirmed bookings across ${keys.length} month${keys.length > 1 ? 's' : ''} of data.`;
    } else {
      summaryEl.textContent = 'No booking data available yet.';
    }

    /* cancellation rate */
    if (bookings.length > 0) {
      const nCanceled = bookings.filter(b => isCanceled(b)).length;
      const rate      = Math.round((nCanceled / bookings.length) * 100);
      document.getElementById('trend-cancel').textContent =
        `${rate}% of all bookings get cancelled (all-time rate).`;
    }

    /* chart */
    const labels    = last12.map(fmtMonth);
    const counts    = last12.map(k => byMonth[k].count);
    const paxVals   = last12.map(k => byMonth[k].pax);
    const realPax   = paxVals.some(p => p > counts[paxVals.indexOf(p)] + 1);

    if (trendChart) { trendChart.destroy(); trendChart = null; }

    const ctx = document.getElementById('trend-chart').getContext('2d');
    const datasets = [{
      type: 'bar',
      label: 'Bookings',
      data: counts,
      backgroundColor: 'rgba(200,121,74,0.7)',
      borderColor: '#c8794a',
      borderWidth: 1,
      borderRadius: 3,
      yAxisID: 'y',
    }];

    if (realPax) {
      datasets.push({
        type: 'line',
        label: 'Pax',
        data: paxVals,
        borderColor: '#f5f3ee',
        backgroundColor: 'transparent',
        tension: 0.35,
        pointRadius: 3,
        pointBackgroundColor: '#f5f3ee',
        yAxisID: 'y1',
      });
    }

    const gridColor  = 'rgba(255,255,255,0.06)';
    const tickColor  = '#8a8a92';
    const tickFont   = { family: 'Inter', size: 10, color: tickColor };

    trendChart = new Chart(ctx, {
      data: { labels, datasets },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        interaction: { mode: 'index', intersect: false },
        plugins: {
          legend: {
            display: realPax,
            labels: { font: { family: 'Inter', size: 11 }, color: tickColor },
          },
        },
        scales: {
          y: {
            type: 'linear',
            position: 'left',
            beginAtZero: true,
            grid: { color: gridColor },
            ticks: { stepSize: 1, font: tickFont, color: tickColor },
            title: { display: false },
          },
          ...(realPax ? {
            y1: {
              type: 'linear',
              position: 'right',
              beginAtZero: true,
              grid: { drawOnChartArea: false, color: gridColor },
              ticks: { font: tickFont, color: tickColor },
            }
          } : {}),
          x: {
            grid: { color: gridColor },
            ticks: { font: tickFont, color: tickColor },
          }
        }
      }
    });
  }

  /* ── Segments ──────────────────────────────────────── */
  function renderSegments() {
    const container = document.getElementById('segments-container');
    if (segView === 'plain') {
      /* v_segment_counts is already aggregated and sorted by total_value desc */
      const maxTot = segCounts.length ? segCounts[0].total_value : 1;

      container.innerHTML = segCounts.length
        ? segCounts.map(g => {
            const pct = maxTot > 0 ? Math.round((g.total_value / maxTot) * 100) : 0;
            const n   = Number(g.customers);
            return `<div class="seg-card">
              <div class="seg-row">
                <span class="seg-label">${esc(g.segment_label)}</span>
                <span class="seg-count">${n.toLocaleString()} customer${n !== 1 ? 's' : ''}</span>
              </div>
              <div class="seg-meaning">${esc(g.segment_meaning)}</div>
              <div class="seg-bar-track"><div class="seg-bar" style="width:${pct}%"></div></div>
              <div class="seg-row">
                <span class="seg-value">${fmtRM(g.total_value)}</span>
                <span class="seg-action">→ ${esc(g.segment_action)}</span>
              </div>
            </div>`;
          }).join('')
        : '<p class="empty-state">No segment data yet.</p>';

    } else {
      /* v_rfm_counts is already aggregated — avg_score and total_value pre-computed */
      const RFM = {
        vip:            { label: 'VIP',            color: '#C08D5D', desc: 'Frequent, high-spend, recent visitors' },
        loyal:          { label: 'Loyal',          color: '#4a7c59', desc: 'Strong across frequency, spend & recency' },
        needs_nudge:    { label: 'Needs a nudge',  color: '#3a7abf', desc: 'Decent scores — just needs a reason to return' },
        win_back:       { label: 'Win back',       color: '#d97706', desc: 'Good historical spend, quiet for 6+ months' },
        sleeping_giant: { label: 'Sleeping giant', color: '#7c3aed', desc: 'Absent for over a year' },
        low_value:      { label: 'Low value',      color: '#9ca3af', desc: 'Low scores across the board' },
      };
      const ORDER = ['vip','loyal','needs_nudge','win_back','sleeping_giant','low_value'];

      const sorted = ORDER
        .map(s => rfmCounts.find(r => r.rfm_segment === s))
        .filter(Boolean);

      container.innerHTML = sorted.length
        ? sorted.map(g => {
            const meta = RFM[g.rfm_segment] || { label: g.rfm_segment, color: '#9ca3af', desc: '' };
            const n    = Number(g.customers);
            return `<div class="seg-card">
              <div class="seg-row">
                <span class="seg-label" style="color:${meta.color}">
                  <span class="rfm-dot" style="background:${meta.color}"></span>${esc(meta.label)}
                </span>
                <span class="seg-count">${n.toLocaleString()} customer${n !== 1 ? 's' : ''}</span>
              </div>
              <div class="seg-meaning">${esc(meta.desc)}</div>
              <div class="seg-row">
                <span class="seg-value">${fmtRM(g.total_value)}</span>
                <span class="rfm-score">avg ${g.avg_score}/100</span>
              </div>
            </div>`;
          }).join('')
        : '<p class="empty-state">No RFM data yet.</p>';
    }
  }

  /* ── Leads table ───────────────────────────────────── */
  function renderLeads() {
    const tbody = document.getElementById('leads-tbody');

    if (!leads.length) {
      tbody.innerHTML = `<tr><td colspan="7" class="empty-td">No records match this filter.</td></tr>`;
    } else {
      tbody.innerHTML = leads.map(l => {
        const isHot    = l.lead_type === 'booked, no StoreHub match';
        const tagColor = {
          'customer + booker':         '#4a7c59',
          'customer (walk-in)':        '#3a7abf',
          'booked, no StoreHub match': '#d97706',
        }[l.lead_type] || '#9ca3af';

        return `<tr class="${isHot ? 'hot-row' : ''}">
          <td>${esc(l.name || '—')}</td>
          <td class="mono">${esc(l.phone_e164 || '—')}</td>
          <td class="num">${fmtRM(l.total_spent)}</td>
          <td class="num">${l.total_visits || 0}</td>
          <td>${fmtDate(l.last_visit)}</td>
          <td class="num">${l.total_bookings || 0}</td>
          <td><span class="lead-tag" style="background:${tagColor}22;color:${tagColor};border:1px solid ${tagColor}44">
            ${esc(l.lead_type || '—')}
          </span></td>
        </tr>`;
      }).join('');
    }

    /* Pagination controls */
    const totalPages = Math.ceil(leadsTotal / PAGE_SIZE) || 1;
    const start      = leadsPage * PAGE_SIZE + 1;
    const end        = Math.min(start + leads.length - 1, leadsTotal);
    document.getElementById('leads-page-info').textContent =
      `${start}–${end} of ${leadsTotal.toLocaleString()}`;
    document.getElementById('leads-prev').disabled = leadsPage === 0;
    document.getElementById('leads-next').disabled = leadsPage >= totalPages - 1;
  }

  async function goLeadsPage(delta) {
    leadsPage = Math.max(0, leadsPage + delta);
    const r = await fetchLeadsPage(leadsPage);
    if (r.error) { showError(`v_leads: ${r.error.message}`); return; }
    leads      = r.data || [];
    leadsTotal = r.count ?? leadsTotal;
    renderLeads();
  }

  /* ── Acquisition note ──────────────────────────────── */
  function renderAcquisition() {
    const counts = {};
    leads.forEach(l => {
      const utm = (l.utm_source || '').trim().toLowerCase() || null;
      if (utm) counts[utm] = (counts[utm] || 0) + 1;
    });

    const tagged   = Object.entries(counts).sort((a, b) => b[1] - a[1]);
    const untagged = leads.filter(l => !l.utm_source || !l.utm_source.trim()).length;
    const total    = leads.length;

    let msg;
    if (tagged.length) {
      const topStr = tagged.slice(0, 3)
        .map(([k, v]) => `${v} from ${k}`).join(', ');
      msg = `Acquisition: ${topStr}.` +
        (untagged ? ` ${untagged} of ${total} customers had no UTM source tagged.` : '');
    } else {
      msg = `Acquisition: none of the ${total} customers have a UTM source tag — consider adding UTM links to your Instagram/ads.`;
    }

    document.getElementById('acq-note').textContent = msg;
  }

  /* ── XSS helper ────────────────────────────────────── */
  function esc(str) {
    return String(str)
      .replace(/&/g,'&amp;').replace(/</g,'&lt;')
      .replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  }

  /* ══════════════════════════════════════════════════════
     EVENT WIRING
  ══════════════════════════════════════════════════════ */
  document.addEventListener('DOMContentLoaded', () => {

    /* Magic link submit */
    document.getElementById('magic-link-btn')
      .addEventListener('click', sendMagicLink);
    document.getElementById('email-input')
      .addEventListener('keydown', e => { if (e.key === 'Enter') sendMagicLink(); });

    /* Sign out */
    document.getElementById('signout-btn')
      .addEventListener('click', handleSignOut);

    /* Refresh buttons */
    document.getElementById('refresh-hdr-btn')
      .addEventListener('click', loadData);
    document.getElementById('refresh-err-btn')
      .addEventListener('click', loadData);

    /* Date filter */
    document.getElementById('date-filter-strip')
      .addEventListener('click', e => {
        const btn = e.target.closest('[data-mode]');
        if (!btn) return;
        dateMode = btn.dataset.mode;
        document.querySelectorAll('.df-btn')
          .forEach(b => b.classList.toggle('active', b === btn));
        const customRow = document.getElementById('custom-date-row');
        customRow.style.display = dateMode === 'custom' ? 'flex' : 'none';
        if (dateMode !== 'custom') render();
      });

    document.getElementById('apply-custom-btn')
      .addEventListener('click', () => {
        customFrom = document.getElementById('date-from').value;
        customTo   = document.getElementById('date-to').value;
        if (customFrom && customTo) render();
      });

    /* Segment tabs */
    document.getElementById('tab-plain').addEventListener('click', () => {
      segView = 'plain';
      document.getElementById('tab-plain').classList.add('active');
      document.getElementById('tab-rfm').classList.remove('active');
      renderSegments();
    });
    document.getElementById('tab-rfm').addEventListener('click', () => {
      segView = 'rfm';
      document.getElementById('tab-rfm').classList.add('active');
      document.getElementById('tab-plain').classList.remove('active');
      renderSegments();
    });

    /* Leads filter — reset to page 0, re-fetch server-side */
    document.getElementById('leads-filter-strip')
      .addEventListener('click', async e => {
        const btn = e.target.closest('[data-filter]');
        if (!btn) return;
        leadsFilter = btn.dataset.filter;
        leadsPage   = 0;
        document.querySelectorAll('.lf-btn')
          .forEach(b => b.classList.toggle('active', b === btn));
        const r = await fetchLeadsPage(0);
        if (r.error) { showError(`v_leads: ${r.error.message}`); return; }
        leads      = r.data || [];
        leadsTotal = r.count ?? 0;
        renderLeads();
      });

    /* Table sort — reset to page 0, re-fetch server-side */
    document.querySelector('#leads-table thead')
      .addEventListener('click', async e => {
        const th = e.target.closest('th[data-col]');
        if (!th) return;
        const col = th.dataset.col;
        if (sortCol === col) { sortAsc = !sortAsc; }
        else { sortCol = col; sortAsc = false; }
        leadsPage = 0;
        document.querySelectorAll('#leads-table th')
          .forEach(h => {
            h.classList.remove('sorted-asc', 'sorted-desc');
            if (h.dataset.col === sortCol)
              h.classList.add(sortAsc ? 'sorted-asc' : 'sorted-desc');
          });
        const r = await fetchLeadsPage(0);
        if (r.error) { showError(`v_leads: ${r.error.message}`); return; }
        leads      = r.data || [];
        leadsTotal = r.count ?? leadsTotal;
        renderLeads();
      });

    /* Leads pagination */
    document.getElementById('leads-prev')
      .addEventListener('click', () => goLeadsPage(-1));
    document.getElementById('leads-next')
      .addEventListener('click', () => goLeadsPage(1));

    /* Boot auth */
    initAuth();
  });

})();
</script>

</body>
</html>
