---
interface Props {
  title: string;
  description?: string;
  image?: string;
}

const { 
  title, 
  description = "NZ Coffee - The Taste You Never Forget",
  image = "/nz-og.jpg" 
} = Astro.props;

// Create an absolute URL for the social sharing image
const siteUrl = Astro.site || Astro.url.origin;
const socialImageURL = new URL(image, siteUrl);
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    
    <link rel="icon" type="image/jpeg" href="/logo.jpg" />
    <meta name="generator" content={Astro.generator} />
    
    <title>{title || "NZ Coffee"}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={title || "NZ Coffee"} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={socialImageURL} />

    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={Astro.url} />
    <meta property="twitter:title" content={title || "NZ Coffee"} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={socialImageURL} />
    
    <slot name="head" />
  </head>
  <body class="bg-[#0F0F0F] text-white">
    <slot />
  </body>
</html>